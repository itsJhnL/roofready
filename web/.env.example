# Supabase project (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never exposed to the browser

# Python extraction service
EXTRACTOR_URL=http://127.0.0.1:8000
EXTRACTOR_API_KEY=                                  # optional, must match the extractor's EXTRACTOR_API_KEY

# Optional: password-protect a hosted demo (leave blank locally)
DEMO_USER=
DEMO_PASSWORD=
